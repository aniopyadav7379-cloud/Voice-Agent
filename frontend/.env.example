# Base URL of the token-service backend (agent/app/security/token_service.py).
VITE_API_BASE_URL=http://localhost:8000

# Your LiveKit server/cloud URL, e.g. wss://your-project.livekit.cloud
VITE_LIVEKIT_URL=

# Do NOT put LIVEKIT_API_SECRET, JWT_SECRET, SARVAM_API_KEY, MOSS_PROJECT_KEY,
# DATABASE_URL, or any Gemini/Google credentials in this file. Vite exposes
# every VITE_-prefixed variable to the browser bundle -- only client-safe
# values belong here. Those secrets live in the backend's own environment.
