# Production environment reference for Render -- names and correct FORMATS
# only. Never commit real values here; paste them into Render's dashboard
# (each service's Environment tab) or into render.yaml as `sync: false`
# entries (see render.yaml at the repo root of this folder).

# --- shared by both services -------------------------------------------
DATABASE_URL=postgresql://neondb_owner:npg_AGyzVPXnN9S4@ep-royal-violet-b46m26kc-pooler.c-6.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Neon (and most managed Postgres) give you a `postgresql://...` URL with
# `sslmode=require&channel_binding=require` in the query string. That exact
# string does NOT work here -- this app's engine is asyncpg-based
# (SQLAlchemy `create_async_engine`), and asyncpg's connect() rejects the
# libpq-style `sslmode`/`channel_binding` keywords outright
# (`TypeError: connect() got an unexpected keyword argument 'sslmode'`).
# Fix, verified in this session: change the scheme to `postgresql+asyncpg://`
# and replace `sslmode=require&channel_binding=require` with `ssl=require`.

LIVEKIT_API_KEY=APIWSaVDXfdZdc2
LIVEKIT_API_SECRET=uvSZrlReQMliwIn0P6AfNl4yr9NkPRiGxGo4bcvtCsO

# --- token service (web) only -------------------------------------------
JWT_SECRET=72a38849b06bc4ff43da4aad86f1faf08a0fad1ac6f1b1dd5767d5b5a2a32d4e556f72bfdb2f7ddb950929447bf5a1615cf0f0ba25a1c6d8e7900f572934e9a7
JWT_ISSUER=voice-agent-platform
ENVIRONMENT=development
# READ THIS BEFORE DEPLOYING PUBLICLY: with ENVIRONMENT=development,
# POST /v1/dev/token is live and unauthenticated -- anyone who has (or
# guesses) your Render URL can mint a valid app JWT + LiveKit token for any
# tenant_slug/external_id they type in, no login required. That's fine for
# your own testing but is a real open door on a public URL. This project's
# own code deliberately does not implement production auth (see the
# docstring in app/security/token_service.py) -- there is no "just flip
# ENVIRONMENT to something else" fix, because nothing else issues tokens.
# Don't share this URL publicly while it's in this state.
ALLOWED_ORIGINS=https://YOUR-APP.vercel.app
# Comma-separated if you need more than one (e.g. also a Vercel preview
# URL or http://localhost:5173 for local testing against the deployed
# backend). No default is permissive -- an empty value blocks every
# browser origin.

# --- agent worker (background worker) only -------------------------------
LIVEKIT_URL=wss://voice-0zf4tggh.livekit.cloud
MOSS_PROJECT_ID=eb37a26c-2743-4f2f-9e33-57ff1bd4c6a9
MOSS_PROJECT_KEY=moss_e8cebd2f3b0fb65475499db3ee095ae6
SARVAM_API_KEY=sk_cx5gtlkr_SZjd3GW9Q7EiYzq4RAOcN34p
GEMINI_MODEL=gemini-2.0-flash
GOOGLE_API_KEY=
# MISSING from the .env this checklist was built from. Required by
# livekit-plugins-google's LLM class -- confirmed in this session by
# reading livekit/plugins/google/llm.py: with no api_key argument passed
# (agent_entrypoint.py doesn't pass one) it falls back to
# os.environ.get("GOOGLE_API_KEY") and raises if that's also unset. Get one
# from Google AI Studio (a Gemini API key) -- it's a different credential
# from anything already in this file.
QDRANT_LOCATION=:memory:
# Works, but every point upserted via upsert_document() lives only in this
# one worker process's RAM: it's gone on every restart/redeploy, and if you
# ever scale to more than one worker instance, each instance has its own
# empty, disconnected knowledge base. Fine for a single always-on demo
# worker; not fine as a real knowledge store. A persistent Qdrant instance
# (Qdrant Cloud, or self-hosted) is a `QDRANT_LOCATION=https://...` /
# `QDRANT_API_KEY=...` swap away -- app/context/qdrant_provider.py takes an
# AsyncQdrantClient it doesn't otherwise care how it was constructed.
