# Production environment reference.
# NEVER put real credentials in this file.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/vap

# --- LiveKit WebRTC ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Token Service ---
JWT_SECRET=
JWT_ISSUER=voice-agent-platform
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173

# --- LLM Providers (at least one required) ---
# Groq (Fast inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Primary or fallback)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- Voice & Speech Providers ---
SARVAM_API_KEY=

# --- Context & Vector Memory (Optional) ---
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
QDRANT_LOCATION=:memory:
