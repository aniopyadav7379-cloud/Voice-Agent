# Environment configuration example for Voice Agent Platform
# Copy this file to agent/.env and populate your actual keys

# --- Database (Neon Postgres or standard PostgreSQL) ---
DATABASE_URL=postgresql+asyncpg://neondb_owner:password@ep-host.aws.neon.tech/neondb?ssl=require

# --- LiveKit WebRTC Cloud ---
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- Token Service & Auth ---
JWT_SECRET=your_jwt_secret_64_chars_or_more
JWT_ISSUER=voice-agent-platform
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --- LLM Providers (at least one required) ---
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.3-70b-versatile

GOOGLE_API_KEY=...
GEMINI_MODEL=gemini-2.0-flash

# --- Voice & Speech Providers ---
SARVAM_API_KEY=sk_...

# --- Vector & Context Memory (Optional) ---
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
QDRANT_LOCATION=:memory:
